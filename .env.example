# =============================================================================
# DWMS — environment template
# =============================================================================
# Copy to .env before running anything:
#     cp .env.example .env
#
# .env is gitignored. NEVER commit it. NEVER commit real credentials.
# The values below are LOCAL DEVELOPMENT ONLY. Production values live in a
# secret manager (see infrastructure/), never in this file.
#
# Generate a strong local secret with:
#     openssl rand -hex 32
# =============================================================================


# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=debug                  # debug | info | warning | error
TZ=UTC

# Public base URL of the API gateway (used by frontend and simulators)
API_BASE_URL=http://localhost:8080


# -----------------------------------------------------------------------------
# PostgreSQL + PostGIS  (services/locations, services/requests)
# -----------------------------------------------------------------------------
# PostGIS is required — the container image must be postgis/postgis, not plain postgres.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dwms
POSTGRES_USER=dwms
POSTGRES_PASSWORD=change-me-local-dev-only

# Separate schemas, same instance. Services must not query each other's schema.
LOCATIONS_DB_SCHEMA=locations
REQUESTS_DB_SCHEMA=requests

# Full DSNs (compose constructs these from the parts above; useful for native dev)
LOCATIONS_DATABASE_URL=postgresql+asyncpg://dwms:change-me-local-dev-only@localhost:5432/dwms
REQUESTS_DATABASE_URL=postgresql+asyncpg://dwms:change-me-local-dev-only@localhost:5432/dwms


# -----------------------------------------------------------------------------
# Redis  (services/realtime pub/sub backplane, services/map viewport cache)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Viewport query cache TTL in seconds. Set to 0 to disable caching.
MAP_CACHE_TTL_SECONDS=15


# -----------------------------------------------------------------------------
# MQTT broker  (IoT bin telemetry → services/locations)
# -----------------------------------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_BINS= dwms/bins/+/telemetry
MQTT_CLIENT_ID=locations-ingest


# -----------------------------------------------------------------------------
# Authentication  (services/gateway)
# -----------------------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated origins allowed to call the gateway (frontend dev servers)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting (requests per minute, per client)
RATE_LIMIT_PER_MINUTE=120


# -----------------------------------------------------------------------------
# Internal service URLs  (gateway routing targets)
# -----------------------------------------------------------------------------
LOCATIONS_SERVICE_URL=http://locations:8001
MAP_SERVICE_URL=http://map:8002
REQUESTS_SERVICE_URL=http://requests:8003
REALTIME_SERVICE_URL=http://realtime:8004


# -----------------------------------------------------------------------------
# Map & palette  (services/map — Objective 2)
# -----------------------------------------------------------------------------
# The palette is a versioned specification. Do NOT override colours via env;
# change palette.json and open an ADR. This path only locates the file.
PALETTE_CONFIG_PATH=/app/style/palette.json

# Base map tiles. Must be openly licensed or locally served.
# No commercial API keys — see CONTRIBUTING.md → Dependency & Secrets Policy.
MAP_TILE_SOURCE_URL=http://localhost:8085/tiles/{z}/{x}/{y}.pbf
MAP_DEFAULT_CENTER_LAT=0.0
MAP_DEFAULT_CENTER_LON=0.0
MAP_DEFAULT_ZOOM=12

# Reports older than this render greyed out ("unknown / stale" bucket).
REPORT_STALENESS_TTL_DAYS=7

# Maximum features returned per viewport query (protects the map from overload)
MAP_MAX_FEATURES_PER_QUERY=2000


# -----------------------------------------------------------------------------
# SPF requests  (services/requests — Objective 3)
# -----------------------------------------------------------------------------
# SPF = the waste-collection service provider. Values are integration endpoints.
SPF_CONTACT_EMAIL=spf@example.org
SPF_WEBHOOK_URL=                 # leave blank to disable outbound dispatch in dev
SPF_DEFAULT_SLA_HOURS=48


# -----------------------------------------------------------------------------
# Notifications  (services/notifications)
# -----------------------------------------------------------------------------
# Leave all providers blank in local dev — the worker logs instead of sending.
# These are dev stubs. Do not put real provider credentials in a committed file.
EMAIL_PROVIDER=console           # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=dwms@example.org

SMS_PROVIDER=console             # console | (your provider)
SMS_API_KEY=


# -----------------------------------------------------------------------------
# Frontend  (frontend/dashboard, frontend/reporter)
# Vite exposes only VITE_-prefixed vars to the browser. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_REALTIME_URL=ws://localhost:8081
VITE_DASHBOARD_PORT=3000
VITE_REPORTER_PORT=3001
VITE_MAP_DEFAULT_ZOOM=12


# -----------------------------------------------------------------------------
# Simulators  (simulator/iot_bins, simulator/field_reports)
# -----------------------------------------------------------------------------
SIM_BIN_COUNT=10
SIM_INTERVAL_SECONDS=5
SIM_REPORT_COUNT=50
# Bounding box for generated waste locations: lat_min,lon_min,lat_max,lon_max
SIM_BBOX=0.0,0.0,0.1,0.1


# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
# Integration tests use a separate database so they never touch dev data.
TEST_DATABASE_URL=postgresql+asyncpg://dwms:change-me-local-dev-only@localhost:5433/dwms_test
TEST_REDIS_URL=redis://localhost:6380/1
